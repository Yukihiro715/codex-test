# 求人マップ（kyujinmap.jp・内部コード名 WORKLENS）web アプリの環境変数。apps/web/.env.local にコピーして使う。
# キーや秘密情報はコミットしない。外部サービスのキーがなくても M0 は起動・テストできる。

# demo = 架空fixture（M0）／ live = 実データ（M1で実装。M0では起動できない）
DATA_MODE=demo
# 本番判定は NODE_ENV ではなくこの値で行う（production では DATA_MODE=demo・fixtureで起動を停止＝REL01）
APP_ENV=local
# 実ソースのライブ収集（M1以降。審査記録・operatorのactivationがないソースは true でも有効化されない）
ENABLE_LIVE_CRAWL=false
# クリック課金（M3まで true にできない。true にすると起動を停止する）
ENABLE_BILLING=false
# JobPosting構造化データ（許可・必須項目の揃った full_authorized 求人だけ。デモでは常に出力しない）
ENABLE_JOBPOSTING=false
# サイトの公開URL（canonical・sitemap・OGPの基準）。未設定なら https://kyujinmap.jp。ステージングではそのURLを設定する
# （静的に生成するページがあるため、ビルド時と実行時の両方に同じ値を設定する）
# SITE_URL=https://kyujinmap.jp
# デモの基準時刻（fixtureの鮮度計算を実行日に依存させない）
DEMO_NOW=2026-09-29T12:00:00Z
# 管理画面デモの簡易ログイン（APP_ENV=production では常に無効）
ADMIN_DEMO_LOGIN=true
# 管理セッションの署名キー（16文字以上）。未設定時は開発用の固定値を使う。本番では必須
# ADMIN_SESSION_SECRET=
# 訂正・削除申請のレート制限（窓あたりの件数・窓の秒数）
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_SECONDS=600
# Next.js のテレメトリ送信を止める（M0は外部送信なしの方針）
NEXT_TELEMETRY_DISABLED=1
